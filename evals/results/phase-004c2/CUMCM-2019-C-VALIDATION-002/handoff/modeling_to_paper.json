  "assumptions": [
    {
      "assumption_id": "A1",
      "challenge": "Correlated batches, abandonment and matching bottlenecks violate the waiting model.",
      "requirements": [
        "REQ-Q1",
        "REQ-Q2"
      ],
      "text": "Passenger parties follow a piecewise-constant NHPP induced by assumed flight-exit pulses; taxis ahead depart one per party in FCFS order."
    },
    {
      "assumption_id": "A2",
      "challenge": "Congestion, shifts and risk aversion can alter the decision.",
      "requirements": [
        "REQ-Q1"
      ],
      "text": "Taxi destination mix is independent of queue waiting; city net opportunity cost is constant, A/B compared relative to future city earning."
    },
    {
      "assumption_id": "A3",
      "challenge": "These are assumed design conditions, not surveyed facts; real geometry or violations invalidate safety applicability.",
      "requirements": [
        "REQ-Q3"
      ],
      "text": "Q3 has two 35m lanes, 7m bay pitch, protected holding and fenced crossings; passenger access and all vehicle motion are mutually exclusive."
    },
    {
      "assumption_id": "A4",
      "challenge": "Insufficient demand/supply or correlated boarding changes achieved throughput.",
      "requirements": [
        "REQ-Q3"
      ],
      "text": "Q3 saturated passenger and taxi queues give a capacity bound; batch boarding durations are independent lognormal variables."
    },
    {
      "assumption_id": "A5",
      "challenge": "Outside drivers, fraud and refusal require operating controls outside this simulation.",
      "requirements": [
        "REQ-Q4"
      ],
      "text": "Q4 closed fleet returns empty, destinations exogenous, credits cannot be sold or split and expire after one return visit."
    },
    {
      "assumption_id": "A6",
      "challenge": "Actual calibration and external validation cannot be replaced by simulation.",
      "requirements": [
        "REQ-Q2"
      ],
      "text": "Every numeric scenario value is an explicit modeling assumption; no real airport/urban taxi observations are supplied."
    }
  ],
