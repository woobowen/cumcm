{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/adversarial_finding/v1",
  "title": "Adversarial Finding",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "finding_id",
    "role",
    "target",
    "severity",
    "claim_attacked",
    "attack",
    "counterexample",
    "evidence",
    "required_test",
    "pass_condition",
    "fail_condition",
    "confidence",
    "unresolved",
    "recommended_action",
    "statement",
    "evidence_refs",
    "testability",
    "status"
  ],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "severity": {"enum": ["BLOCKER", "ERROR", "WARNING", "INFO"]},
    "claim_attacked": {"type": "string", "minLength": 1},
    "attack": {"type": "string", "minLength": 1},
    "counterexample": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_test": {"type": "string", "minLength": 1},
    "pass_condition": {"type": "string", "minLength": 1},
    "fail_condition": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "unresolved": {"type": "boolean"},
    "recommended_action": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "testability": {"enum": ["TESTABLE", "NON_TESTABLE_CLAIM"]},
    "status": {"enum": ["OPEN", "TEST_REQUESTED", "CLOSED", "UNCERTAINTY"]}
  },
  "additionalProperties": false
}
