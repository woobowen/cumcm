            "version": {"const": "0.2.0-competition-rc1"},
            "capability": {"const": "COMPETITION_RC"},
            "discoverable_count": {"const": 1},
            "workflow_count": {"const": 14},
            "role_count": {"const": 4}
          },
          "additionalProperties": false
        },
        "end_to_end": {
          "type": "object",
          "required": ["result_sha256", "passed", "prediction_state", "optimization_state"],
          "properties": {
            "result_sha256": {"const": "3beefd5190547246a361e6829a2236224927af8a9673cc0344ff62f78676fa99"},
            "passed": {"const": 2},
            "prediction_state": {"const": "READY_FOR_PAPER_HANDOFF"},
            "optimization_state": {"const": "READY_FOR_PAPER_HANDOFF"}
          },
          "additionalProperties": false
        },
        "negative_tests": {
          "type": "object",
          "required": ["result_sha256", "passed", "failed", "unhandled_exceptions"],
          "properties": {
            "result_sha256": {"const": "5c46849aee853b1bb1d9af43f7ea22d827681852e6a2150da6ad4bd0cd2f5f60"},
            "passed": {"const": 30},
            "failed": {"const": 0},
            "unhandled_exceptions": {"const": 0}
          },
          "additionalProperties": false
        },
        "integration_audit": {
          "type": "object",
          "required": ["status", "path", "sha256"],
          "properties": {
            "status": {"const": "PASS"},
            "path": {"const": "evals/results/phase-003f-r1/formal_skill_integration/audit.json"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "assurance": {"const": "PUBLIC_DETERMINISTIC_AND_TWO_END_TO_END_SMOKES"},
        "full_r3_status": {"const": "DEFERRED_NOT_PASSED"},
        "deferred_validation": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "allOf": [
            {"contains": {"const": "full sealed Stage 1"}},
            {"contains": {"const": "Stage 2 model comparison"}},
            {"contains": {"const": "full ablation"}},
            {"contains": {"const": "external validity"}},
            {"contains": {"const": "production fitness"}},
            {"contains": {"const": "monetary cost"}}
          ]
        },
        "api_calls": {"const": 0},
        "model_training": {"const": false},
        "real_comparison_model_starts": {"const": 0},
        "native_subagent_runs": {"const": 3},
        "third_party_executions": {"const": 0}
      },
      "additionalProperties": false
    },
    "development_eval": {
      "type": "object",
      "required": [
        "case_id",
        "set_type",
        "answer_access_status",
        "model_prior_status",
        "first_run_status",
        "first_run_freeze_status",
        "unlock_status",
        "problem_hash",
        "data_hashes",
        "search_log_path",
        "skill_start_commit",
        "skill_start_tree_hash",
        "revision_cycles_used",
        "stress_statuses"
      ],
      "properties": {
        "case_id": {
          "enum": ["CUMCM-2023-C-DEVELOPMENT-001", "CUMCM-2020-A-DEVELOPMENT-002"]
        },
        "set_type": {"const": "DEVELOPMENT"},
        "answer_access_status": {
          "enum": ["SEALED", "UNLOCKED_AFTER_FIRST_RUN", "PERMANENTLY_DEVELOPMENT"]
        },
        "model_prior_status": {"const": "MODEL_PRIOR_EXPOSURE_UNVERIFIABLE"},
        "first_run_status": {"enum": ["IN_PROGRESS", "FROZEN"]},
        "first_run_freeze_status": {"enum": ["NOT_RUN", "PASS", "FAIL"]},
        "unlock_status": {"enum": ["LOCKED", "UNLOCKED_AFTER_FIRST_RUN"]},
        "problem_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "data_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "search_log_path": {"const": "research/pre_freeze_search_log.jsonl"},
        "skill_start_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "skill_start_tree_hash": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "revision_cycles_used": {"type": "integer", "minimum": 0, "maximum": 2},
        "stress_statuses": {
          "type": "object",
          "required": ["A", "B", "C"],
          "properties": {
            "A": {"enum": ["NOT_RUN", "PASS", "FAIL", "INCOMPLETE"]},
            "B": {"enum": ["NOT_RUN", "PASS", "FAIL", "INCOMPLETE"]},
            "C": {"enum": ["NOT_RUN", "PASS", "FAIL", "INCOMPLETE"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "next_phase_allowed": {"type": ["string", "null"]},
    "content_verified_commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence_expansion": {
      "type": "object",
      "required": [
        "cohort_mode",
        "cohort_id",
        "model",
        "reasoning_setting",
        "transport_profile",
        "target_successes",
        "attempts",
        "successes",
        "failures",
        "balanced_cases",
        "repeat_depth",
        "budget_remaining",
        "current_batch",
        "infrastructure_status"
      ],
      "properties": {
        "cohort_mode": {"type": ["string", "null"]},
        "cohort_id": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "reasoning_setting": {"type": ["string", "null"]},
        "transport_profile": {"type": ["string", "null"]},
        "target_successes": {"type": ["integer", "null"], "minimum": 0},
        "attempts": {"type": "integer", "minimum": 0},
        "successes": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "balanced_cases": {"type": "array", "items": {"type": "string"}},
        "repeat_depth": {"type": "integer", "minimum": 0},
        "budget_remaining": {"type": ["object", "null"]},
        "current_batch": {"type": "integer", "minimum": 0},
        "infrastructure_status": {"type": "string", "minLength": 1},
        "repeat_depth_deprecated": {"type": "boolean"},
        "quality_balanced_case_count": {"type": ["integer", "null"], "minimum": 0},
        "quality_minimum_repeat_depth": {"type": ["integer", "null"], "minimum": 0},
        "outcome_resolved_case_count": {"type": ["integer", "null"], "minimum": 0},
        "outcome_minimum_repeat_depth": {"type": ["integer", "null"], "minimum": 0},
        "schedule_attempted_repeat_depth": {"type": ["integer", "null"], "minimum": 0},
        "reliability_observed_repeat_depth": {"type": ["integer", "null"], "minimum": 0},
        "resolved_success_slots": {"type": ["integer", "null"], "minimum": 0},
        "resolved_terminal_negative_slots": {"type": ["integer", "null"], "minimum": 0},
        "infrastructure_censored_slots": {"type": ["integer", "null"], "minimum": 0},
        "harness_censored_slots": {"type": ["integer", "null"], "minimum": 0},
        "unknown_slots": {"type": ["integer", "null"], "minimum": 0},
        "supplemental_run_authorized": {"type": ["boolean", "null"]},
        "supplemental_budget_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "verification_manifest": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["path", "sha256", "subject_commit"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "delivery_receipt_for_commit": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["commit", "remote", "remote_sha", "verified_at"],
          "properties": {
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "remote": {"type": "string", "minLength": 1},
            "remote_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "verified_at": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "team_compliance_review_status": {
      "enum": ["NOT_RUN", "RECORDED", "CHALLENGED", "CLOSED"]
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "base_selected": {"type": "boolean"},
    "third_party_integrated": {"const": false},
    "skill_capability_status": {"enum": ["SCAFFOLD_ONLY", "COMPETITION_RC"]},
    "updated_at": {"type": "string", "minLength": 1},
    "updated_by": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "PHASE-EVIDENCE-EXPANSION-002D"}}},
      "then": {"required": ["evidence_expansion"]}
    },
    {
      "if": {
        "properties": {
          "technical_adjudication_status": {
            "const": "FAILURE_AWARE_ADJUDICATION_IN_PROGRESS"
          }
        },
        "required": ["technical_adjudication_status"]
      },
      "then": {
        "properties": {
          "phase": {"const": "PHASE-EVIDENCE-EXPANSION-002D"},
          "subphase": {
            "const": "PHASE-002D-R1-FAILURE-AWARE-OUTCOME-ADJUDICATION"
          },
          "status": {"const": "IN_PROGRESS"},
          "selected_architecture": {"type": "null"},
          "accepted_component_specifications": {"maxItems": 0},
          "next_phase_allowed": {"type": "null"},
          "base_selected": {"const": false},
          "third_party_integrated": {"const": false},
          "skill_capability_status": {"const": "SCAFFOLD_ONLY"}
        },
        "required": ["evidence_expansion"]
      }
    },
    {
      "if": {
        "properties": {
          "technical_adjudication_status": {
            "const": "FAILURE_AWARE_ADJUDICATION_COMPLETE"
          }
        },
        "required": ["technical_adjudication_status"]
      },
      "then": {
        "properties": {
          "phase": {"const": "PHASE-EVIDENCE-EXPANSION-002D"},
          "subphase": {
            "const": "PHASE-002D-R1-FAILURE-AWARE-OUTCOME-ADJUDICATION"
          },
          "status": {"const": "IN_PROGRESS"},
          "selected_architecture": {"type": "null"},
          "accepted_component_specifications": {"minItems": 1},
          "next_phase_allowed": {"const": "PHASE-EVIDENCE-EXPANSION-002D"},
          "base_selected": {"const": false},
          "third_party_integrated": {"const": false},
          "skill_capability_status": {"const": "SCAFFOLD_ONLY"}
        },
        "required": ["evidence_expansion"]
      }
    },
    {
      "if": {
        "properties": {
          "technical_adjudication_status": {"const": "SPECIFICATION_PROTOCOL_IN_PROGRESS"}
        },
        "required": ["technical_adjudication_status"]
      },
      "then": {
        "properties": {
          "phase": {"const": "PHASE-EVIDENCE-EXPANSION-002D"},
