      "enum": [
        "AUTOMATED_ADJUDICATION_PENDING",
        "AUTOMATED_ADJUDICATION_RECOVERY_IN_PROGRESS",
        "AUTOMATED_EVIDENCE_SUFFICIENCY_IN_PROGRESS",
        "EVIDENCE_EXPANSION_IN_PROGRESS",
        "FAILURE_AWARE_ADJUDICATION_IN_PROGRESS",
        "FAILURE_AWARE_ADJUDICATION_COMPLETE",
        "SPECIFICATION_PROTOCOL_IN_PROGRESS",
        "SPECIFICATION_PROTOCOL_COMPLETE",
        "SPECIFICATION_PROTOCOL_INCOMPLETE",
        "SHADOW_PROTOTYPE_AUTHORIZATION_IN_PROGRESS",
        "SHADOW_PROTOTYPE_AUTHORIZATION_COMPLETE",
        "SHADOW_PROTOTYPE_AUTHORIZATION_INCOMPLETE",
        "SHADOW_PROTOTYPE_VALIDATION_IN_PROGRESS",
        "SHADOW_PROTOTYPE_VALIDATION_COMPLETE",
        "SHADOW_PROTOTYPE_VALIDATION_INCOMPLETE",
        "COMPETITION_SKILL_RC_READY",
        "DEVELOPMENT_FIRST_RUN_IN_PROGRESS",
        "DEVELOPMENT_EVAL_RC2_READY",
        "DEVELOPMENT_EVAL_RC3_READY",
        "DEVELOPMENT_EVAL_COMPLETE_NO_SKILL_CHANGE",
        "DEVELOPMENT_EVAL_INCOMPLETE",
        "OFFICIAL_INPUTS_REQUIRED",
        "FIRST_RUN_CONTAMINATION_SUSPECTED",
        "INFRASTRUCTURE_BLOCKED",
        "MODEL_INFRASTRUCTURE_BLOCKED",
        "EVIDENCE_EXPANSION_INCOMPLETE",
        "AUTOMATED_ADJUDICATION_INCOMPLETE",
        "AUTOMATED_ADJUDICATION_COMPLETE",
        "AUTOMATED_ACCEPTED",
        "AUTOMATED_REJECTED",
        "RETEST_REQUIRED",
        "EVIDENCE_INSUFFICIENT",
        "AUTOMATED_ABSTAINED",
        "STALE"
      ]
    },
    "automated_decision_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "selected_architecture": {"type": ["string", "null"]},
    "accepted_component_specifications": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "architecture_candidate_set": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "specification_protocol": {
      "type": "object",
      "required": [
        "input_freeze_id",
        "input_freeze_hash",
        "implementation_embargo_status",
        "benchmark_freeze_status",
        "threshold_policy_status",
        "decision_audit_status",
        "replay_stable",
        "real_model_starts",
        "native_subagent_runs",
        "prototype_executions",
        "third_party_executions"
      ],
      "properties": {
        "input_freeze_id": {"const": "PHASE-002D-R2-INPUT-FREEZE-001"},
        "input_freeze_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "implementation_embargo_status": {"enum": ["PASS", "FAIL"]},
        "benchmark_freeze_status": {"enum": ["NOT_RUN", "BENCHMARK_FROZEN", "RETEST_REQUIRED", "STALE"]},
        "threshold_policy_status": {"enum": ["NOT_RUN", "POLICY_FROZEN", "RETEST_REQUIRED", "STALE"]},
        "decision_audit_status": {"enum": ["NOT_RUN", "PASS", "FAIL", "RETEST_REQUIRED"]},
        "replay_stable": {"type": "boolean"},
        "real_model_starts": {"const": 0},
        "native_subagent_runs": {"type": "integer", "minimum": 0},
        "prototype_executions": {"const": 0},
        "third_party_executions": {"const": 0}
      },
      "additionalProperties": false
    },
    "shadow_authorization": {
      "type": "object",
      "required": [
        "input_freeze_id",
        "input_freeze_hash",
        "candidate_id",
        "candidate_hash",
        "candidate_file_sha256",
        "canonical_candidate_hash",
        "candidate_freeze_hash",
        "active_decision_id",
        "active_decision_hash",
        "replaces_non_active_candidate_id",
        "supersedes_decision_id",
        "supersedes_decision_hash",
        "supersedes_file_sha256",
        "historical_compatibility_hash",
        "schema_resolution_hash",
        "candidate_closure_hash",
        "final_audit_bundle_hash",
        "final_audit_result",
        "final_audit_checkpoint_hash",
        "final_replay_stable",
        "final_replay_hash",
        "replay_input_freeze_hash",
        "replay_decision_hash",
        "replay_audit_checkpoint_hash"
      ],
      "properties": {
        "input_freeze_id": {
          "enum": [
            "PHASE-002D-R2A-INPUT-FREEZE-001",
            "PHASE-002D-R2A-C1-INPUT-FREEZE-001"
          ]
        },
        "input_freeze_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_id": {"type": ["string", "null"]},
        "candidate_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "candidate_file_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "canonical_candidate_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "candidate_freeze_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "active_decision_id": {"type": ["string", "null"]},
        "active_decision_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "replaces_non_active_candidate_id": {"type": ["string", "null"]},
        "supersedes_decision_id": {"const": "DECISION-SHADOW-PROTOTYPE-AUTHORIZATION-002D-R2"},
        "supersedes_decision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "supersedes_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "historical_compatibility_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "schema_resolution_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "candidate_closure_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "final_audit_bundle_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "final_audit_result": {"enum": ["NOT_RUN", "PASS", "FAIL", "RETEST_REQUIRED"]},
        "final_audit_checkpoint_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "final_replay_stable": {"type": "boolean"},
        "final_replay_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "replay_input_freeze_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "replay_decision_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "replay_audit_checkpoint_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "shadow_validation": {
      "type": "object",
      "required": [
        "starting_authorization_id",
        "input_freeze_id",
        "input_freeze_hash",
        "prototype_implementation_count",
        "prototype_execution_count",
        "real_model_starts",
        "native_subagent_runs",
        "stage1_status",
        "stage2_status",
        "decision_audit_status",
        "replay_stable"
      ],
      "properties": {
        "starting_authorization_id": {"const": "DECISION-SHADOW-PROTOTYPE-AUTHORIZATION-002D-R2A-C2"},
        "input_freeze_id": {"type": ["string", "null"]},
        "input_freeze_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "prototype_implementation_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "prototype_execution_count": {"type": "integer", "minimum": 0},
        "real_model_starts": {"type": "integer", "minimum": 0, "maximum": 30},
        "native_subagent_runs": {"type": "integer", "minimum": 0},
        "stage1_status": {"enum": ["NOT_RUN", "PASS", "FAIL", "STALE"]},
        "stage2_status": {"enum": ["NOT_RUN", "PASS", "BLOCKED", "INCOMPLETE", "STALE"]},
        "decision_audit_status": {"enum": ["NOT_RUN", "PASS", "FAIL", "RETEST_REQUIRED"]},
        "replay_stable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "competition_rc1": {
