          "properties": {
            "decision_id": {"const": "DECISION-COMPETITION-MVP-ARCHITECTURE-003F"},
            "decision_hash": {"const": "2ed22c0e6ba08159077ae891bfb310947fa007e84dd38fdde2af54beeef25b5d"},
            "result": {"const": "FAST_TRACK_IMPLEMENTATION_BLOCKED"},
            "artifact_sha256": {"const": "70cd886ad2efb226769bb15a26d041554f12d24c2bf3acc8c87b90f6527156a1"}
