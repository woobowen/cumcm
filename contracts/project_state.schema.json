          "type": "object",
          "required": ["result_sha256", "k1_passed", "w1_passed", "case_evaluations", "unhandled_exceptions"],
          "properties": {
            "result_sha256": {"const": "07d4362f0c2d0c6b502bcae99748e18f825ded4662554fb860d4db483376b971"},
            "k1_passed": {"const": 8},
            "w1_passed": {"const": 8},
            "case_evaluations": {"const": 234},
            "unhandled_exceptions": {"const": 0}
          },
          "additionalProperties": false
        },
        "formal_skill": {
          "type": "object",
          "required": ["name", "version", "capability", "discoverable_count", "workflow_count", "role_count"],
