{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/project_state/v2.2",
  "title": "Project State",
  "version": "2.2.0",
  "type": "object",
  "required": [
    "project_id",
    "schema_version",
    "phase",
    "subphase",
    "status",
    "current_plan",
    "active_skill_version",
    "current_branch",
    "technical_adjudication_status",
    "automated_decision_ids",
    "selected_architecture",
    "accepted_component_specifications",
    "next_phase_allowed",
    "content_verified_commit",
    "verification_manifest",
    "delivery_receipt_for_commit",
    "team_compliance_review_status",
    "blockers",
    "risks",
    "base_selected",
    "third_party_integrated",
    "skill_capability_status",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "2.2.0"},
    "phase": {"type": "string", "minLength": 1},
    "subphase": {"type": ["string", "null"]},
    "status": {"enum": ["IN_PROGRESS", "FOUNDATION_READY", "FOUNDATION_INCOMPLETE", "STALE"]},
    "current_plan": {"type": "string", "minLength": 1},
    "active_skill_version": {"type": "string", "minLength": 1},
    "current_branch": {"type": "string", "minLength": 1},
    "technical_adjudication_status": {
      "enum": [
        "AUTOMATED_ADJUDICATION_PENDING",
        "AUTOMATED_ADJUDICATION_RECOVERY_IN_PROGRESS",
        "AUTOMATED_EVIDENCE_SUFFICIENCY_IN_PROGRESS",
        "EVIDENCE_EXPANSION_IN_PROGRESS",
        "FAILURE_AWARE_ADJUDICATION_IN_PROGRESS",
        "FAILURE_AWARE_ADJUDICATION_COMPLETE",
        "SPECIFICATION_PROTOCOL_IN_PROGRESS",
        "SPECIFICATION_PROTOCOL_COMPLETE",
        "SPECIFICATION_PROTOCOL_INCOMPLETE",
        "EVIDENCE_EXPANSION_INCOMPLETE",
        "AUTOMATED_ADJUDICATION_INCOMPLETE",
        "AUTOMATED_ADJUDICATION_COMPLETE",
        "AUTOMATED_ACCEPTED",
        "AUTOMATED_REJECTED",
        "RETEST_REQUIRED",
        "EVIDENCE_INSUFFICIENT",
        "AUTOMATED_ABSTAINED",
        "STALE"
      ]
    },
    "automated_decision_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "selected_architecture": {"type": ["string", "null"]},
    "accepted_component_specifications": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "architecture_candidate_set": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "specification_protocol": {
      "type": "object",
      "required": [
        "input_freeze_id",
        "input_freeze_hash",
        "implementation_embargo_status",
        "benchmark_freeze_status",
        "threshold_policy_status",
        "decision_audit_status",
        "replay_stable",
        "real_model_starts",
        "native_subagent_runs",
        "prototype_executions",
        "third_party_executions"
      ],
      "properties": {
        "input_freeze_id": {"const": "PHASE-002D-R2-INPUT-FREEZE-001"},
        "input_freeze_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "implementation_embargo_status": {"enum": ["PASS", "FAIL"]},
        "benchmark_freeze_status": {"enum": ["NOT_RUN", "BENCHMARK_FROZEN", "RETEST_REQUIRED", "STALE"]},
        "threshold_policy_status": {"enum": ["NOT_RUN", "POLICY_FROZEN", "RETEST_REQUIRED", "STALE"]},
        "decision_audit_status": {"enum": ["NOT_RUN", "PASS", "FAIL", "RETEST_REQUIRED"]},
        "replay_stable": {"type": "boolean"},
        "real_model_starts": {"const": 0},
        "native_subagent_runs": {"type": "integer", "minimum": 0},
        "prototype_executions": {"const": 0},
        "third_party_executions": {"const": 0}
      },
      "additionalProperties": false
    },
    "next_phase_allowed": {"type": ["string", "null"]},
    "content_verified_commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence_expansion": {
      "type": "object",
      "required": [
        "cohort_mode",
        "cohort_id",
        "model",
        "reasoning_setting",
        "transport_profile",
        "target_successes",
        "attempts",
        "successes",
        "failures",
        "balanced_cases",
        "repeat_depth",
        "budget_remaining",
        "current_batch",
        "infrastructure_status"
      ],
      "properties": {
        "cohort_mode": {"type": ["string", "null"]},
        "cohort_id": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "reasoning_setting": {"type": ["string", "null"]},
        "transport_profile": {"type": ["string", "null"]},
        "target_successes": {"type": ["integer", "null"], "minimum": 0},
        "attempts": {"type": "integer", "minimum": 0},
        "successes": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "balanced_cases": {"type": "array", "items": {"type": "string"}},
        "repeat_depth": {"type": "integer", "minimum": 0},
        "budget_remaining": {"type": ["object", "null"]},
        "current_batch": {"type": "integer", "minimum": 0},
        "infrastructure_status": {"type": "string", "minLength": 1},
        "repeat_depth_deprecated": {"type": "boolean"},
        "quality_balanced_case_count": {"type": ["integer", "null"], "minimum": 0},
        "quality_minimum_repeat_depth": {"type": ["integer", "null"], "minimum": 0},
        "outcome_resolved_case_count": {"type": ["integer", "null"], "minimum": 0},
        "outcome_minimum_repeat_depth": {"type": ["integer", "null"], "minimum": 0},
        "schedule_attempted_repeat_depth": {"type": ["integer", "null"], "minimum": 0},
        "reliability_observed_repeat_depth": {"type": ["integer", "null"], "minimum": 0},
        "resolved_success_slots": {"type": ["integer", "null"], "minimum": 0},
        "resolved_terminal_negative_slots": {"type": ["integer", "null"], "minimum": 0},
        "infrastructure_censored_slots": {"type": ["integer", "null"], "minimum": 0},
        "harness_censored_slots": {"type": ["integer", "null"], "minimum": 0},
        "unknown_slots": {"type": ["integer", "null"], "minimum": 0},
        "supplemental_run_authorized": {"type": ["boolean", "null"]},
        "supplemental_budget_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "verification_manifest": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["path", "sha256", "subject_commit"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "delivery_receipt_for_commit": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["commit", "remote", "remote_sha", "verified_at"],
          "properties": {
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "remote": {"type": "string", "minLength": 1},
            "remote_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "verified_at": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "team_compliance_review_status": {
      "enum": ["NOT_RUN", "RECORDED", "CHALLENGED", "CLOSED"]
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "base_selected": {"type": "boolean"},
    "third_party_integrated": {"const": false},
    "skill_capability_status": {"const": "SCAFFOLD_ONLY"},
    "updated_at": {"type": "string", "minLength": 1},
    "updated_by": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "PHASE-EVIDENCE-EXPANSION-002D"}}},
      "then": {"required": ["evidence_expansion"]}
    },
    {
      "if": {
        "properties": {
          "technical_adjudication_status": {
            "const": "FAILURE_AWARE_ADJUDICATION_IN_PROGRESS"
          }
        },
        "required": ["technical_adjudication_status"]
      },
      "then": {
        "properties": {
          "phase": {"const": "PHASE-EVIDENCE-EXPANSION-002D"},
          "subphase": {
            "const": "PHASE-002D-R1-FAILURE-AWARE-OUTCOME-ADJUDICATION"
          },
          "status": {"const": "IN_PROGRESS"},
          "selected_architecture": {"type": "null"},
          "accepted_component_specifications": {"maxItems": 0},
          "next_phase_allowed": {"type": "null"},
          "base_selected": {"const": false},
          "third_party_integrated": {"const": false},
          "skill_capability_status": {"const": "SCAFFOLD_ONLY"}
        },
        "required": ["evidence_expansion"]
      }
    },
    {
      "if": {
        "properties": {
          "technical_adjudication_status": {
            "const": "FAILURE_AWARE_ADJUDICATION_COMPLETE"
          }
        },
        "required": ["technical_adjudication_status"]
      },
      "then": {
        "properties": {
          "phase": {"const": "PHASE-EVIDENCE-EXPANSION-002D"},
          "subphase": {
            "const": "PHASE-002D-R1-FAILURE-AWARE-OUTCOME-ADJUDICATION"
          },
          "status": {"const": "IN_PROGRESS"},
          "selected_architecture": {"type": "null"},
          "accepted_component_specifications": {"minItems": 1},
          "next_phase_allowed": {"const": "PHASE-EVIDENCE-EXPANSION-002D"},
          "base_selected": {"const": false},
          "third_party_integrated": {"const": false},
          "skill_capability_status": {"const": "SCAFFOLD_ONLY"}
        },
        "required": ["evidence_expansion"]
      }
    },
    {
      "if": {
        "properties": {
          "technical_adjudication_status": {"const": "SPECIFICATION_PROTOCOL_IN_PROGRESS"}
        },
        "required": ["technical_adjudication_status"]
      },
      "then": {
        "properties": {
          "phase": {"const": "PHASE-EVIDENCE-EXPANSION-002D"},
          "subphase": {"const": "PHASE-002D-R2-CLEAN-ROOM-SPECIFICATION-AND-PROSPECTIVE-PROTOCOL"},
          "status": {"const": "IN_PROGRESS"},
          "current_plan": {"const": "plans/active/PLAN-0002D-R2-specification-and-protocol.md"},
          "selected_architecture": {"type": "null"},
          "accepted_component_specifications": {
            "minItems": 4,
            "maxItems": 4,
            "allOf": [
              {"contains": {"const": "accepted-versus-done-workflow-state"}},
              {"contains": {"const": "claim-evidence-support-gate"}},
              {"contains": {"const": "hash-bound-reproducibility-manifest"}},
              {"contains": {"const": "leakage-safe-model-comparison-gate"}}
            ]
          },
          "architecture_candidate_set": {"maxItems": 0},
          "next_phase_allowed": {"type": "null"},
          "base_selected": {"const": false},
          "third_party_integrated": {"const": false},
          "skill_capability_status": {"const": "SCAFFOLD_ONLY"}
        },
        "required": ["evidence_expansion", "architecture_candidate_set", "specification_protocol"]
      }
    },
    {
      "if": {
        "properties": {
          "technical_adjudication_status": {"const": "SPECIFICATION_PROTOCOL_COMPLETE"}
        },
        "required": ["technical_adjudication_status"]
      },
      "then": {
        "properties": {
          "phase": {"const": "PHASE-EVIDENCE-EXPANSION-002D"},
          "subphase": {"const": "PHASE-002D-R2-CLEAN-ROOM-SPECIFICATION-AND-PROSPECTIVE-PROTOCOL"},
          "status": {"const": "IN_PROGRESS"},
          "selected_architecture": {"type": "null"},
          "accepted_component_specifications": {"minItems": 4, "maxItems": 4},
          "architecture_candidate_set": {
            "minItems": 2,
            "maxItems": 3,
            "contains": {"const": "ARCH-S0-RETAIN-SCAFFOLD-ONLY"}
          },
          "next_phase_allowed": {
            "enum": [
              "PHASE-002D-R3-SHADOW-PROTOTYPE-VALIDATION",
              "PHASE-002D-R2-CLEAN-ROOM-SPECIFICATION-AND-PROSPECTIVE-PROTOCOL",
              null
            ]
          },
          "base_selected": {"const": false},
          "third_party_integrated": {"const": false},
          "skill_capability_status": {"const": "SCAFFOLD_ONLY"},
          "specification_protocol": {
            "properties": {
              "implementation_embargo_status": {"const": "PASS"},
              "benchmark_freeze_status": {"const": "BENCHMARK_FROZEN"},
              "threshold_policy_status": {"const": "POLICY_FROZEN"},
              "decision_audit_status": {"const": "PASS"},
              "replay_stable": {"const": true}
            }
          }
        },
        "required": ["evidence_expansion", "architecture_candidate_set", "specification_protocol"]
      }
    }
  ],
  "additionalProperties": false
}
