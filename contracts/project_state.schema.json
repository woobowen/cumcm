        "architecture_decision": {
          "type": "object",
          "required": ["decision_id", "decision_hash", "artifact_sha256", "selected_architecture"],
          "properties": {
            "decision_id": {"const": "DECISION-COMPETITION-RC1-ARCHITECTURE-003F-R1"},
            "decision_hash": {"const": "8b4c50dbe5f95ca04ceff4c489ae83dc3a4afa81e156e1f00f16b2ac65f25cbe"},
            "artifact_sha256": {"const": "20b6d4c0086c8ab8e3a81f442fba63977db3d557f2143d91db86d0a4993bfa03"},
