{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/dissent_record/v2",
  "title": "Independent Blind Dissent Record",
  "version": "2.0.0",
  "type": "object",
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["finding_id", "severity", "target", "statement", "evidence_refs", "testability", "status"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["BLOCKER", "ERROR", "WARNING", "INFO"]},
        "target": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "testability": {"enum": ["TESTABLE", "NON_TESTABLE_CLAIM"]},
        "status": {"enum": ["OPEN", "RESOLVED", "UNRESOLVED"]}
      },
      "additionalProperties": false
    }
  },
  "required": ["dissent_id", "role", "bundle_id", "bundle_hash", "input_bundle_hash", "policy_hash", "evidence_hash", "model", "reasoning_setting", "independent", "identity_blind", "other_judges_visible", "majority_vote_used", "human_technical_gate_used", "recovery_ranked", "findings", "recommendation", "evidence_sufficiency", "strongest_dissent", "strongest_dissent_evidence_refs", "test_evidence_refs", "unresolved_blockers", "evidence_refs", "confidence", "uncertainties", "checkpoint_hash"],
  "properties": {
    "dissent_id": {"type": "string", "minLength": 1},
    "role": {"const": "BLIND_DISSENT_JUDGE"},
    "bundle_id": {"type": "string", "minLength": 1},
    "bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model": {"type": "string", "minLength": 1},
    "reasoning_setting": {"type": "string", "minLength": 1},
    "independent": {"const": true},
    "identity_blind": {"const": true},
    "other_judges_visible": {"const": false},
    "majority_vote_used": {"const": false},
    "human_technical_gate_used": {"const": false},
    "recovery_ranked": {"const": false},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "recommendation": {"enum": ["REJECT", "RETEST", "INSUFFICIENT", "ABSTAIN", "NO_DISSENT"]},
    "evidence_sufficiency": {"enum": ["SUFFICIENT", "INSUFFICIENT"]},
    "strongest_dissent": {"type": "string", "minLength": 1},
    "strongest_dissent_evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "test_evidence_refs": {"type": "array", "items": {"type": "string"}},
    "unresolved_blockers": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "checkpoint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
