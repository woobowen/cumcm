{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cumcm.local/contracts/test_evidence/v1","title":"Executed Test Evidence","version":"1.0.0","type":"object","required":["test_id","finding_id","status","observed_result","oracle_result","command_or_procedure","artifact_hashes","started_at","completed_at"],"properties":{"test_id":{"type":"string","minLength":1},"finding_id":{"type":"string","minLength":1},"status":{"enum":["PASSED","FAILED","ERROR","TIMEOUT"]},"observed_result":{"type":"string"},"oracle_result":{"type":"boolean"},"command_or_procedure":{"type":"string","minLength":1},"artifact_hashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"started_at":{"type":"string","format":"date-time"},"completed_at":{"type":"string","format":"date-time"}},"additionalProperties":false}
