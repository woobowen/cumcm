{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/expansion-attempt/v1",
  "title": "Phase 002D Expansion Attempt",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version", "attempt_id", "execution_kind", "cohort_id", "cohort_hash",
    "case_id", "anonymous_arm_id", "repeat_id", "cell_id", "schedule_block",
    "schedule_order", "schedule_hash", "fresh_session", "resume_used",
    "parser_recovery_used", "transport_profile", "model", "reasoning_setting",
    "codex_version", "auth_mode", "sandbox", "network_policy", "mcp_policy",
    "prompt_hash", "task_input_hash", "fixture_hash", "package_hash", "schema_hash",
    "policy_hash", "oracle_hash", "scorer_hash", "runner_hash", "budget_hash",
    "subject_commit", "workspace_commit",
    "start_time", "end_time", "duration_seconds", "exit_code", "completion_status",
    "failure_class", "retry_of", "input_tokens", "cached_input_tokens", "output_tokens",
    "reasoning_tokens", "event_summary", "observable_commands", "files_written",
    "input_mutated", "schema_valid", "oracle_status", "process_evidence_status",
    "robustness_status", "hard_failures", "primary_eligible", "exclusion_reasons",
    "result_hashes", "raw_trace_hash", "stderr_hash", "manual_intervention",
    "api_key_used", "api_billing_used", "attempt_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "attempt_id": {"type": "string", "pattern": "^EXP-CASE-[0-9]{3}-ARM-[ABC]-R[12]-A0[123]$"},
    "execution_kind": {"const": "REAL_CODEX"},
    "cohort_id": {"type": "string", "minLength": 1},
    "cohort_hash": {"$ref": "#/$defs/hash"},
    "case_id": {"enum": ["CASE-001", "CASE-002", "CASE-004", "CASE-006"]},
    "anonymous_arm_id": {"enum": ["ARM-A", "ARM-B", "ARM-C"]},
    "repeat_id": {"type": "integer", "minimum": 1, "maximum": 2},
    "cell_id": {"type": "string", "minLength": 1},
    "schedule_block": {"type": "string", "minLength": 1},
    "schedule_order": {"type": "integer", "minimum": 1, "maximum": 3},
    "schedule_hash": {"$ref": "#/$defs/hash"},
    "fresh_session": {"const": true},
    "resume_used": {"const": false},
    "parser_recovery_used": {"const": false},
    "transport_profile": {"enum": ["NO_PROXY_PROCESS_ONLY", "PROXY_INHERITED"]},
    "model": {"type": "string", "minLength": 1},
    "reasoning_setting": {"const": "medium"},
    "codex_version": {"type": "string", "minLength": 1},
    "auth_mode": {"const": "CHATGPT_MANAGED_CODEX"},
    "sandbox": {"const": "workspace-write"},
    "network_policy": {"const": "DISABLED_REQUIRED"},
    "mcp_policy": {"const": "DISABLED_REQUIRED"},
    "prompt_hash": {"$ref": "#/$defs/hash"},
    "task_input_hash": {"$ref": "#/$defs/hash"},
    "fixture_hash": {"$ref": "#/$defs/hash"},
    "package_hash": {"$ref": "#/$defs/hash"},
    "schema_hash": {"$ref": "#/$defs/hash"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "oracle_hash": {"$ref": "#/$defs/hash"},
    "scorer_hash": {"$ref": "#/$defs/hash"},
    "runner_hash": {"$ref": "#/$defs/hash"},
    "budget_hash": {"$ref": "#/$defs/hash"},
    "subject_commit": {"$ref": "#/$defs/git_hash"},
    "workspace_commit": {"$ref": "#/$defs/git_hash"},
    "start_time": {"type": "string", "minLength": 1},
    "end_time": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "number", "minimum": 0, "maximum": 900},
    "exit_code": {"type": ["integer", "null"]},
    "completion_status": {"enum": ["COMPLETED", "FAILED"]},
    "failure_class": {"type": ["string", "null"]},
    "retry_of": {"type": ["string", "null"]},
    "input_tokens": {"$ref": "#/$defs/token"},
    "cached_input_tokens": {"$ref": "#/$defs/token"},
    "output_tokens": {"$ref": "#/$defs/token"},
    "reasoning_tokens": {"$ref": "#/$defs/token"},
    "event_summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "observable_commands": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "files_written": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "input_mutated": {"type": "boolean"},
    "schema_valid": {"type": "boolean"},
    "oracle_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
    "process_evidence_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
    "robustness_status": {"enum": ["PENDING_CROSS_REPEAT", "PASS", "FAIL", "INSUFFICIENT"]},
    "hard_failures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "primary_eligible": {"type": "boolean"},
    "exclusion_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "result_hashes": {
      "type": "object",
      "required": ["observation", "oracle", "process_evidence", "coverage", "eligibility"],
      "properties": {
        "observation": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "oracle": {"$ref": "#/$defs/hash"},
        "process_evidence": {"$ref": "#/$defs/hash"},
        "coverage": {"$ref": "#/$defs/hash"},
        "eligibility": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "raw_trace_hash": {"$ref": "#/$defs/hash"},
    "stderr_hash": {"$ref": "#/$defs/hash"},
    "manual_intervention": {"const": false},
    "api_key_used": {"const": false},
    "api_billing_used": {"const": false},
    "attempt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_hash": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "token": {"type": ["integer", "null"], "minimum": 0}
  },
  "additionalProperties": false
}
