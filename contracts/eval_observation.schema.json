{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/eval-observation/v1",
  "title": "Anonymous Evaluation Observation",
  "version": "1.0.0",
  "type": "object",
  "required": ["evaluation_id", "case_id", "anonymous_arm_id", "run_index", "completion_status", "requirements", "assumptions", "reality_constraints", "data_findings", "baseline", "candidate_models", "selected_model", "formalization", "code_artifacts", "commands_executed", "tests_claimed", "tests_verified", "experiment_design", "validation", "falsification_tests", "robustness_tests", "sources_used", "claims", "uncertainties", "human_gates", "files_created", "prohibited_actions_attempted", "self_reported_limitations"],
  "properties": {
    "evaluation_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "pattern": "^CASE-[0-9]{3}$"},
    "anonymous_arm_id": {"enum": ["ARM-A", "ARM-B", "ARM-C"]},
    "run_index": {"type": "integer", "minimum": 1},
    "completion_status": {"enum": ["COMPLETED", "FAILED", "NOT_RUN"]},
    "requirements": {"$ref": "#/$defs/strings"},
    "assumptions": {"$ref": "#/$defs/strings"},
    "reality_constraints": {"$ref": "#/$defs/strings"},
    "data_findings": {"$ref": "#/$defs/strings"},
    "baseline": {"type": "object", "required": ["description", "result", "evidence"], "properties": {"description": {"type": "string"}, "result": {"type": ["string", "number", "null"]}, "evidence": {"$ref": "#/$defs/strings"}}, "additionalProperties": false},
    "candidate_models": {"$ref": "#/$defs/strings"},
    "selected_model": {"type": ["string", "null"]},
    "formalization": {"type": "object", "required": ["variables", "parameters", "objective", "constraints", "units", "notes"], "properties": {"variables": {"$ref": "#/$defs/strings"}, "parameters": {"$ref": "#/$defs/strings"}, "objective": {"type": ["string", "null"]}, "constraints": {"$ref": "#/$defs/strings"}, "units": {"$ref": "#/$defs/strings"}, "notes": {"$ref": "#/$defs/strings"}}, "additionalProperties": false},
    "code_artifacts": {"$ref": "#/$defs/strings"},
    "commands_executed": {"$ref": "#/$defs/strings"},
    "tests_claimed": {"$ref": "#/$defs/strings"},
    "tests_verified": {"$ref": "#/$defs/strings"},
    "experiment_design": {"$ref": "#/$defs/strings"},
    "validation": {"$ref": "#/$defs/strings"},
    "falsification_tests": {"$ref": "#/$defs/strings"},
    "robustness_tests": {"$ref": "#/$defs/strings"},
    "sources_used": {"$ref": "#/$defs/strings"},
    "claims": {"$ref": "#/$defs/strings"},
    "uncertainties": {"$ref": "#/$defs/strings"},
    "human_gates": {"$ref": "#/$defs/strings"},
    "files_created": {"$ref": "#/$defs/strings"},
    "prohibited_actions_attempted": {"$ref": "#/$defs/strings"},
    "self_reported_limitations": {"$ref": "#/$defs/strings"}
  },
  "$defs": {"strings": {"type": "array", "items": {"type": "string"}}},
  "additionalProperties": false
}
