{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/expansion-pilot/v1",
  "title": "Phase 002D Calibration Pilot",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "pilot_id", "cohort_id", "cohort_hash", "model", "reasoning_setting", "status", "selected_transport_profile", "attempts", "model_start_count", "maximum_model_starts", "fresh_sessions_only", "resume_used", "counts_as_primary", "counts_as_repeat", "scored_runs_started", "api_key_used", "api_billing_used", "monetary_cost", "classification_corrections", "supersedes_result_hash", "result_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pilot_id": {"const": "CALIBRATION-PILOT-002D-001"},
    "cohort_id": {"type": "string", "minLength": 1},
    "cohort_hash": {"$ref": "#/$defs/hash"},
    "model": {"type": "string", "minLength": 1},
    "reasoning_setting": {"const": "medium"},
    "status": {"enum": ["PASS", "INFRASTRUCTURE_BLOCKED"]},
    "selected_transport_profile": {"type": ["string", "null"], "enum": ["PROXY_INHERITED", "NO_PROXY_PROCESS_ONLY", null]},
    "attempts": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/attempt"}},
    "model_start_count": {"type": "integer", "minimum": 1, "maximum": 2},
    "maximum_model_starts": {"const": 2},
    "fresh_sessions_only": {"const": true},
    "resume_used": {"const": false},
    "counts_as_primary": {"const": false},
    "counts_as_repeat": {"const": false},
    "scored_runs_started": {"const": false},
    "api_key_used": {"const": false},
    "api_billing_used": {"const": false},
    "monetary_cost": {"const": "UNKNOWN"},
    "classification_corrections": {"type": "array", "items": {"type": "object", "required": ["attempt_id", "original_failure_class", "corrected_failure_class", "correction_reason", "attempt_hash_unchanged", "evidence_hash"], "properties": {"attempt_id": {"type": "string", "minLength": 1}, "original_failure_class": {"type": "string", "minLength": 1}, "corrected_failure_class": {"type": "string", "minLength": 1}, "correction_reason": {"type": "string", "minLength": 1}, "attempt_hash_unchanged": {"$ref": "#/$defs/hash"}, "evidence_hash": {"$ref": "#/$defs/hash"}}, "additionalProperties": false}},
    "supersedes_result_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "result_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableInteger": {"type": ["integer", "null"], "minimum": 0},
    "attempt": {
      "type": "object",
      "required": ["schema_version", "attempt_id", "fresh_session", "resume_used", "retry_of", "model", "reasoning_setting", "transport_profile", "proxy_variables_present", "started_at", "ended_at", "duration_seconds", "exit_code", "completion_status", "failure_class", "schema_valid", "oracle_status", "input_mutated", "token_usage", "files_written", "event_summary", "observable_commands", "output", "result_hashes", "raw_trace_hash", "stderr_hash", "stderr_summary", "counts_as_primary", "counts_as_repeat", "api_key_used", "api_billing_used", "attempt_hash"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "attempt_id": {"type": "string", "minLength": 1},
        "fresh_session": {"const": true},
        "resume_used": {"const": false},
        "retry_of": {"type": ["string", "null"]},
        "model": {"type": "string", "minLength": 1},
        "reasoning_setting": {"const": "medium"},
        "transport_profile": {"enum": ["PROXY_INHERITED", "NO_PROXY_PROCESS_ONLY"]},
        "proxy_variables_present": {"type": "boolean"},
        "started_at": {"type": "string", "minLength": 1},
        "ended_at": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "number", "minimum": 0},
        "exit_code": {"type": ["integer", "null"]},
        "completion_status": {"enum": ["PASS", "FAIL"]},
        "failure_class": {"type": ["string", "null"]},
        "schema_valid": {"type": "boolean"},
        "oracle_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "input_mutated": {"type": "boolean"},
        "token_usage": {"type": "object", "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_tokens", "total_tokens"], "properties": {"input_tokens": {"$ref": "#/$defs/nullableInteger"}, "cached_input_tokens": {"$ref": "#/$defs/nullableInteger"}, "output_tokens": {"$ref": "#/$defs/nullableInteger"}, "reasoning_tokens": {"$ref": "#/$defs/nullableInteger"}, "total_tokens": {"$ref": "#/$defs/nullableInteger"}}, "additionalProperties": false},
        "files_written": {"type": "array", "items": {"type": "string"}},
        "event_summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "observable_commands": {"type": "array", "items": {"type": "string"}},
        "output": {"type": ["object", "null"]},
        "result_hashes": {"type": "object", "required": ["structured_output"], "properties": {"structured_output": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
        "raw_trace_hash": {"$ref": "#/$defs/hash"},
        "stderr_hash": {"$ref": "#/$defs/hash"},
        "stderr_summary": {"type": ["string", "null"]},
        "counts_as_primary": {"const": false},
        "counts_as_repeat": {"const": false},
        "api_key_used": {"const": false},
        "api_billing_used": {"const": false},
        "attempt_hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
