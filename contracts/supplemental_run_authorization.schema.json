{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/supplemental-run-authorization/v1",
  "title": "Phase 002D-R1 Supplemental Run Authorization",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version", "decision_id", "decision", "target", "accepted_scope",
    "input_freeze_id", "input_freeze_hash", "slot_matrix_hash",
    "harness_semantic_equivalence", "slot_assessments", "authorized_slot_ids",
    "maximum_real_starts", "maximum_starts_per_slot", "protocol_fingerprint",
    "generic_retry_authorized", "original_budget_mutated", "api_key_used",
    "api_billing_used", "majority_vote_used", "human_technical_gate_used",
    "evidence_refs", "authorization_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "decision_id": {"const": "DECISION-SUPPLEMENTAL-RUN-AUTHORIZATION-002D-R1"},
    "decision": {"enum": ["AUTOMATED_ACCEPTED", "AUTOMATED_REJECTED"]},
    "target": {"enum": ["TARGETED_CENSORED_SLOTS_ONLY", "SUPPLEMENTAL_GENERIC_RUNS"]},
    "accepted_scope": {"enum": ["TARGETED_CENSORED_SLOTS_ONLY", "NONE"]},
    "input_freeze_id": {"type": "string", "minLength": 1},
    "input_freeze_hash": {"$ref": "#/$defs/hash"},
    "slot_matrix_hash": {"$ref": "#/$defs/hash"},
    "harness_semantic_equivalence": {
      "type": "object",
      "required": ["equivalence_id", "status", "bound_file_hashes", "semantic_equivalence_pass", "supplemental_eligible", "equivalence_hash"],
      "properties": {
        "equivalence_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "NOT_ESTABLISHED"]},
        "bound_file_hashes": {"type": "array", "items": {"type": "string"}},
        "semantic_equivalence_pass": {"type": "boolean"},
        "supplemental_eligible": {"type": "boolean"},
        "equivalence_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "slot_assessments": {"type": "array", "items": {"type": "object"}},
    "authorized_slot_ids": {"type": "array", "maxItems": 2, "items": {"type": "string"}, "uniqueItems": true},
    "maximum_real_starts": {"type": "integer", "minimum": 0, "maximum": 4},
    "maximum_starts_per_slot": {"type": "integer", "minimum": 0, "maximum": 2},
    "protocol_fingerprint": {"$ref": "#/$defs/protocol"},
    "generic_retry_authorized": {"const": false},
    "original_budget_mutated": {"const": false},
    "api_key_used": {"const": false},
    "api_billing_used": {"const": false},
    "majority_vote_used": {"const": false},
    "human_technical_gate_used": {"const": false},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "authorization_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "AUTOMATED_REJECTED"}}},
      "then": {
        "properties": {
          "target": {"const": "SUPPLEMENTAL_GENERIC_RUNS"},
          "accepted_scope": {"const": "NONE"},
          "authorized_slot_ids": {"maxItems": 0},
          "maximum_real_starts": {"const": 0},
          "maximum_starts_per_slot": {"const": 0}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "AUTOMATED_ACCEPTED"}}},
      "then": {
        "properties": {
          "target": {"const": "TARGETED_CENSORED_SLOTS_ONLY"},
          "accepted_scope": {"const": "TARGETED_CENSORED_SLOTS_ONLY"},
          "authorized_slot_ids": {"minItems": 1},
          "maximum_real_starts": {"minimum": 1},
          "maximum_starts_per_slot": {"const": 2}
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol": {
      "type": "object",
      "required": ["cohort_hash", "model", "reasoning_setting", "prompt_hash", "schema_hash", "fixture_hash", "package_hash", "scorer_hash", "oracle_hash", "transport_profile"],
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
