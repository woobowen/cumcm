{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/workflow_rules/v1",
  "title": "Workflow Rules",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "version",
    "state_machine_source",
    "required_project_states",
    "required_run_states",
    "formal_state_writer",
    "automated_adjudication",
    "technical_decision_method",
    "team_compliance_review",
    "stale_source",
    "git_delivery",
    "rules"
  ],
  "properties": {
    "version": {"const": "1.0.0"},
    "state_machine_source": {"const": "WORKFLOW.md"},
    "required_project_states": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "required_run_states": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "formal_state_writer": {"const": "MAIN_AGENT_ONLY"},
    "automated_adjudication": {"const": "REQUIRED"},
    "technical_decision_method": {"const": "FROZEN_LEXICOGRAPHIC_EVIDENCE_NO_VOTE"},
    "team_compliance_review": {"const": "NON_TECHNICAL_NO_OVERRIDE"},
    "stale_source": {"const": "WORKFLOW.md"},
    "git_delivery": {
      "type": "object",
      "required": [
        "remote_name",
        "repository",
        "remote_url",
        "protected_base_branch",
        "preferred_task_branch",
        "allow_force_push",
        "allow_agent_merge"
      ],
      "properties": {
        "remote_name": {"const": "origin"},
        "repository": {"const": "woobowen/cumcm"},
        "remote_url": {
          "type": "string",
          "pattern": "^https://github[.]com/[^/]+/[^/]+[.]git$"
        },
        "protected_base_branch": {"const": "main"},
        "preferred_task_branch": {"type": "string", "minLength": 1},
        "allow_force_push": {"const": false},
        "allow_agent_merge": {"const": false}
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "level",
          "scope",
          "statement",
          "failure_severity",
          "enforcement",
          "repair",
          "owner",
          "status"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "level": {"enum": ["MUST", "SHOULD", "MAY"]},
          "scope": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "failure_severity": {"enum": ["BLOCKER", "ERROR", "WARNING", "INFO"]},
          "enforcement": {"type": "object", "minProperties": 1},
          "repair": {"type": "object", "minProperties": 1},
          "owner": {"type": "string", "minLength": 1},
          "status": {"enum": ["ACTIVE", "DEPRECATED"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
