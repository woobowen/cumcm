{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/clean-room-provenance/v1",
  "title": "Clean-room Component Provenance Registry",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "records", "registry_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/provenance"}
    },
    "registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "component_id",
        "source_inspirations",
        "source_commits",
        "source_paths",
        "abstract_mechanisms_observed",
        "content_not_copied",
        "project_specific_design",
        "license_status",
        "allowed_reuse_mode",
        "contamination_status",
        "independent_tests",
        "reviewed_by",
        "provenance_hash"
      ],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "source_inspirations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_commits": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "uniqueItems": true},
        "source_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "abstract_mechanisms_observed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "content_not_copied": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
        "project_specific_design": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "license_status": {"enum": ["VERIFIED_PERMISSIVE_METADATA_ONLY", "UNKNOWN", "UNVERIFIED", "RESTRICTED"]},
        "allowed_reuse_mode": {"const": "REFERENCE_ABSTRACT_MECHANISM"},
        "contamination_status": {"enum": ["CONTAINED_METADATA_ONLY", "UNVERIFIED", "RESTRICTED"]},
        "independent_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reviewed_by": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "provenance_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
