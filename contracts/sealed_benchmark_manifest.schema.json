{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/sealed-benchmark-manifest/v1",
  "title": "Sealed Prospective Benchmark Manifest",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "manifest_id", "status", "benchmark_hash", "generator_hashes", "family_hashes", "public_artifact_hashes", "hidden_seed_hashes", "oracle_interface_hashes", "hidden_case_count", "isolation_level", "vault_path", "contains_hidden_seed", "contains_hidden_oracle", "frozen_before_prototype", "manifest_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"const": "PHASE-002D-R2-SEALED-BENCHMARK-001"},
    "status": {"const": "BENCHMARK_FROZEN"},
    "benchmark_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "family_hashes": {"type": "object", "minProperties": 12, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "public_artifact_hashes": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "hidden_seed_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "oracle_interface_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "hidden_case_count": {"type": "integer", "minimum": 20},
    "isolation_level": {"const": "POLICY_AND_WORKSPACE_ISOLATED_NOT_OS_ENFORCED"},
    "vault_path": {"const": "IGNORED-PHASE-002D-R2-VAULT"},
    "contains_hidden_seed": {"const": false},
    "contains_hidden_oracle": {"const": false},
    "frozen_before_prototype": {"const": true},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
