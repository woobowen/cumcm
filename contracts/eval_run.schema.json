{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/eval-run/v1",
  "title": "Dynamic Evaluation Run",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "case_id", "anonymous_arm_id", "run_index", "execution_kind", "completion_status", "started_at", "ended_at", "duration_seconds", "command", "model", "reasoning_setting", "sandbox", "timeout_seconds", "network_policy", "mcp_policy", "workspace_has_remote", "task_input_hash", "fixture_manifest_hash", "output_schema_hash", "package_hash", "exit_code", "token_usage", "event_summary", "files_written", "result_hashes", "schema_valid", "error_summary", "manual_intervention"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "pattern": "^CASE-[0-9]{3}$"},
    "anonymous_arm_id": {"enum": ["ARM-A", "ARM-B", "ARM-C"]},
    "run_index": {"type": "integer", "minimum": 1},
    "execution_kind": {"enum": ["REAL", "MOCK"]},
    "completion_status": {"enum": ["COMPLETED", "FAILED", "TIMEOUT", "AUTH_BLOCKED", "QUOTA_BLOCKED", "PACKAGE_UNSAFE", "NOT_RUN"]},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "model": {"type": "string", "minLength": 1},
    "reasoning_setting": {"type": "string", "minLength": 1},
    "sandbox": {"const": "workspace-write"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
    "network_policy": {"const": "DISABLED_REQUIRED"},
    "mcp_policy": {"const": "DISABLED_REQUIRED"},
    "workspace_has_remote": {"const": false},
    "task_input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exit_code": {"type": ["integer", "null"]},
    "token_usage": {"type": ["object", "null"], "additionalProperties": {"type": "integer"}},
    "event_summary": {"type": "object", "additionalProperties": {"type": "integer"}},
    "files_written": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "result_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "schema_valid": {"type": "boolean"},
    "error_summary": {"type": ["string", "null"]},
    "manual_intervention": {"type": "boolean"}
  },
  "additionalProperties": false
}
