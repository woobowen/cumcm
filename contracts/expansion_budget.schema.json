{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/expansion-budget/v1",
  "title": "Phase 002D Frozen Execution Budget",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "budget_id", "cohort_id", "cohort_hash", "cohort_mode", "model", "reasoning_setting", "transport_profile", "pilot_result_hash", "target_successes", "maximum_total_attempts", "absolute_attempt_cap", "maximum_attempts_per_cell", "maximum_fresh_retries_per_cell", "maximum_consecutive_infrastructure_failures", "maximum_consecutive_infrastructure_failures_per_cell", "maximum_total_input_tokens", "maximum_total_output_tokens", "maximum_total_elapsed_seconds", "maximum_failed_cells", "batch_size", "maximum_later_batch_size", "concurrency", "historical_metrics", "pilot_metrics", "formula", "formula_values", "token_observability", "monetary_cost", "monetary_cost_reason", "api_key_used", "api_billing_used", "budget_may_expand_after_results", "scored_runs_started_at_freeze", "stop_conditions", "budget_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "budget_id": {"type": "string", "minLength": 1}, "cohort_id": {"type": "string", "minLength": 1}, "cohort_hash": {"$ref": "#/$defs/hash"}, "cohort_mode": {"enum": ["CONTINUATION_COHORT", "NEW_MODEL_COHORT"]}, "model": {"type": "string", "minLength": 1}, "reasoning_setting": {"const": "medium"}, "transport_profile": {"enum": ["PROXY_INHERITED", "NO_PROXY_PROCESS_ONLY"]}, "pilot_result_hash": {"$ref": "#/$defs/hash"},
    "target_successes": {"type": "integer", "minimum": 1, "maximum": 24}, "maximum_total_attempts": {"type": "integer", "minimum": 1, "maximum": 48}, "absolute_attempt_cap": {"enum": [28, 48]}, "maximum_attempts_per_cell": {"const": 3}, "maximum_fresh_retries_per_cell": {"const": 2}, "maximum_consecutive_infrastructure_failures": {"const": 3}, "maximum_consecutive_infrastructure_failures_per_cell": {"const": 2}, "maximum_total_input_tokens": {"type": "integer", "maximum": 10000000}, "maximum_total_output_tokens": {"type": "integer", "minimum": 1}, "maximum_total_elapsed_seconds": {"type": "integer", "minimum": 1, "maximum": 14400}, "maximum_failed_cells": {"type": "integer", "minimum": 0}, "batch_size": {"type": "integer", "minimum": 3, "maximum": 3}, "maximum_later_batch_size": {"type": "integer", "minimum": 3, "maximum": 6}, "concurrency": {"const": 1},
    "historical_metrics": {"type": "object", "required": ["attempts", "successful_primary_records", "observed_success_rate", "input_tokens", "output_tokens", "elapsed_seconds", "run_record_set_hash"], "properties": {"attempts": {"type": "integer", "minimum": 1}, "successful_primary_records": {"type": "integer", "minimum": 0}, "observed_success_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "input_tokens": {"$ref": "#/$defs/distribution"}, "output_tokens": {"$ref": "#/$defs/distribution"}, "elapsed_seconds": {"$ref": "#/$defs/distribution"}, "run_record_set_hash": {"$ref": "#/$defs/hash"}}, "additionalProperties": false},
    "pilot_metrics": {"type": "object", "required": ["attempts", "successful_attempt_duration_seconds", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_tokens"], "properties": {"attempts": {"type": "integer", "minimum": 1, "maximum": 2}, "successful_attempt_duration_seconds": {"type": "number", "minimum": 0}, "input_tokens": {"type": ["integer", "string"], "minimum": 0}, "cached_input_tokens": {"type": ["integer", "string"], "minimum": 0}, "output_tokens": {"type": ["integer", "string"], "minimum": 0}, "reasoning_tokens": {"type": ["integer", "string"], "minimum": 0}}, "additionalProperties": false},
    "formula": {"type": "object", "additionalProperties": {"type": "string"}}, "formula_values": {"type": "object", "required": ["base_attempts", "expected_total_input_tokens", "expected_total_output_tokens", "expected_total_elapsed_seconds"], "properties": {"base_attempts": {"type": "integer", "minimum": 1}, "expected_total_input_tokens": {"type": "integer", "minimum": 0, "maximum": 10000000}, "expected_total_output_tokens": {"type": "integer", "minimum": 0}, "expected_total_elapsed_seconds": {"type": "integer", "minimum": 0, "maximum": 14400}}, "additionalProperties": false},
    "token_observability": {"type": "object", "required": ["input_tokens", "output_tokens", "cached_input_tokens", "reasoning_tokens"], "properties": {"input_tokens": {"enum": ["OBSERVED", "UNKNOWN"]}, "output_tokens": {"enum": ["OBSERVED", "UNKNOWN"]}, "cached_input_tokens": {"enum": ["OBSERVED", "UNKNOWN"]}, "reasoning_tokens": {"enum": ["OBSERVED", "UNKNOWN"]}}, "additionalProperties": false},
    "monetary_cost": {"const": "UNKNOWN"}, "monetary_cost_reason": {"const": "CHATGPT_MANAGED_CODEX_NOT_API_BILLING"}, "api_key_used": {"const": false}, "api_billing_used": {"const": false}, "budget_may_expand_after_results": {"const": false}, "scored_runs_started_at_freeze": {"const": false}, "stop_conditions": {"type": "array", "minItems": 10, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "budget_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "distribution": {"type": "object", "required": ["minimum", "median", "maximum"], "properties": {"minimum": {"type": "number", "minimum": 0}, "median": {"type": "number", "minimum": 0}, "maximum": {"type": "number", "minimum": 0}}, "additionalProperties": false}},
  "allOf": [{"if": {"properties": {"cohort_mode": {"const": "NEW_MODEL_COHORT"}}}, "then": {"properties": {"target_successes": {"const": 24}, "absolute_attempt_cap": {"const": 48}}}}],
  "additionalProperties": false
}
