{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/phase002d_decision/v1",
  "title": "Phase 002D Adjudication Precondition Gate",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "gate_id",
    "phase",
    "status",
    "evidence_sufficiency",
    "sufficiency_record_hash",
    "runner_status",
    "runner_hard_stop_reasons",
    "native_subagents_started",
    "automated_decisions_generated",
    "automated_decision_ids",
    "decision_auditor",
    "decision_replay",
    "route_replay",
    "technical_adjudication_status",
    "next_phase_allowed",
    "phase_003_allowed",
    "phase_003_started",
    "automated_decision_contract",
    "record_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "gate_id": {"const": "PHASE-002D-ADJUDICATION-PRECONDITION-GATE"},
    "phase": {"const": "PHASE-EVIDENCE-EXPANSION-002D"},
    "status": {"enum": ["LOCKED_EVIDENCE_INSUFFICIENT", "UNLOCKED_SUFFICIENT"]},
    "evidence_sufficiency": {"enum": ["SUFFICIENT", "INSUFFICIENT", "STALE"]},
    "sufficiency_record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runner_status": {"enum": ["READY", "STOPPED"]},
    "runner_hard_stop_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "native_subagents_started": {"type": "boolean"},
    "automated_decisions_generated": {"type": "boolean"},
    "automated_decision_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "decision_auditor": {"enum": ["NOT_RUN_PRECONDITION_FAILED", "REQUIRED_AFTER_DECISIONS", "PASS", "FAIL"]},
    "decision_replay": {"enum": ["NOT_RUN_PRECONDITION_FAILED", "REQUIRED_AFTER_AUDIT", "PASS", "FAIL"]},
    "route_replay": {"enum": ["PASS", "FAIL"]},
    "technical_adjudication_status": {"const": "EVIDENCE_EXPANSION_INCOMPLETE"},
    "next_phase_allowed": {"const": "PHASE-EVIDENCE-EXPANSION-002D"},
    "phase_003_allowed": {"const": false},
    "phase_003_started": {"const": false},
    "automated_decision_contract": {"const": "contracts/automated_decision.schema.json"},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
