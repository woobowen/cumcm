{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/c2-state-transition/v1",
  "title": "Phase 002D-R2A-C2 Formal State Transition",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version", "transition_id", "artifact_path", "parent_artifact_hash",
    "artifact_sequence_index", "project_state_path", "project_state_schema",
    "project_state_schema_version", "from_technical_status", "to_technical_status",
    "authorization_id", "authorization_hash", "final_audit_id", "final_audit_result",
    "final_audit_output_hash", "final_replay_id", "final_replay_hash",
    "final_replay_stable", "full_ci_before_transition", "selected_architecture",
    "base_selected", "third_party_integrated", "skill_capability_status",
    "prototype_executions", "api_calls", "real_model_in_loop_runs",
    "third_party_executions", "next_phase_allowed", "phase003_prohibited",
    "final_state_hash", "transition_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "transition_id": {"const": "PHASE-002D-R2A-C2-FORMAL-STATE-TRANSITION-001"},
    "artifact_path": {"const": "evals/results/phase-002d-r2a-c1/state_transition/transition-c2.json"},
    "parent_artifact_hash": {"$ref": "#/$defs/hash"},
    "artifact_sequence_index": {"const": 21},
    "project_state_path": {"const": "state/project_state.json"},
    "project_state_schema": {"const": "contracts/project_state.schema.json"},
    "project_state_schema_version": {"const": "2.4.0"},
    "from_technical_status": {"const": "SHADOW_PROTOTYPE_AUTHORIZATION_IN_PROGRESS"},
    "to_technical_status": {"const": "SHADOW_PROTOTYPE_AUTHORIZATION_COMPLETE"},
    "authorization_id": {"const": "DECISION-SHADOW-PROTOTYPE-AUTHORIZATION-002D-R2A-C2"},
    "authorization_hash": {"$ref": "#/$defs/hash"},
    "final_audit_id": {"const": "PHASE-002D-R2A-C2-FINAL-SHADOW-AUTHORIZATION-AUDIT-001"},
    "final_audit_result": {"const": "PASS"},
    "final_audit_output_hash": {"$ref": "#/$defs/hash"},
    "final_replay_id": {"const": "PHASE-002D-R2A-C2-FINAL-AUTHORIZATION-REPLAY-001"},
    "final_replay_hash": {"$ref": "#/$defs/hash"},
    "final_replay_stable": {"const": true},
    "full_ci_before_transition": {
      "type": "object",
      "required": ["status", "passed", "failed", "skipped", "command", "subject_commit"],
      "properties": {
        "status": {"const": "PASS"}, "passed": {"type": "integer", "minimum": 1310},
        "failed": {"const": 0}, "skipped": {"type": "integer", "minimum": 0},
        "command": {"const": "bash scripts/ci.sh"},
        "subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "selected_architecture": {"type": "null"},
    "base_selected": {"const": false},
    "third_party_integrated": {"const": false},
    "skill_capability_status": {"const": "SCAFFOLD_ONLY"},
    "prototype_executions": {"const": 0},
    "api_calls": {"const": 0},
    "real_model_in_loop_runs": {"const": 0},
    "third_party_executions": {"const": 0},
    "next_phase_allowed": {"const": "PHASE-002D-R3-SHADOW-PROTOTYPE-VALIDATION"},
    "phase003_prohibited": {"const": true},
    "final_state_hash": {"$ref": "#/$defs/hash"},
    "transition_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
