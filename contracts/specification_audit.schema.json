{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/specification-audit/v1",
  "title": "Read-only Specification and Protocol Audit",
  "version": "1.0.0",
  "type": "object",
  "required": ["audit_id", "role", "round", "read_only", "peer_outputs_visible", "target", "findings", "proposed_rules", "abstentions", "verdict", "output_hash"],
  "properties": {
    "audit_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "round": {"enum": ["THRESHOLD_DESIGN", "ADVERSARIAL_PROSECUTION"]},
    "read_only": {"const": true},
    "peer_outputs_visible": {"const": false},
    "target": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "proposed_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "abstentions": {"type": "array", "items": {"type": "string"}},
    "verdict": {"enum": ["PASS", "PASS_WITH_FINDINGS", "RETEST_REQUIRED", "REJECT", "ABSTAIN"]},
    "output_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["finding_id", "severity", "claim", "evidence_refs", "recommended_test"],
      "properties": {
        "finding_id": {"type": "string"},
        "severity": {"enum": ["BLOCKER", "ERROR", "WARNING", "INFO"]},
        "claim": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "recommended_test": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
