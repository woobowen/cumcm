{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/component-specification/v1",
  "title": "Clean-room Component Specification",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "component_id", "version", "status", "decision_source", "accepted_scope", "purpose",
    "observed_gap_ids", "supporting_evidence_ids", "non_goals", "clean_room_provenance",
    "actors", "inputs", "outputs", "state_read_set", "state_write_set", "schemas",
    "preconditions", "postconditions", "invariants", "hard_failures", "warnings", "algorithms",
    "deterministic_enforcement", "agent_responsibilities", "stale_propagation", "failure_modes",
    "recovery_behavior", "audit_events", "security_constraints", "privacy_constraints",
    "performance_budget", "token_budget", "maintenance_surface", "interaction_dependencies",
    "interaction_conflicts", "public_conformance_tests", "hidden_property_tests",
    "model_in_loop_tests", "acceptance_metrics", "rejection_conditions", "rollback", "migration",
    "unknowns", "open_risks", "specification_hash"
  ],
  "properties": {
    "component_id": {"type": "string", "minLength": 1},
    "version": {"const": "1.0.0"},
    "status": {"enum": ["SPECIFICATION_DRAFT", "SPECIFICATION_FROZEN"]},
    "decision_source": {"const": "DECISION-COMPONENT-READINESS-002D-R1"},
    "accepted_scope": {"const": "SPECIFICATION_ONLY"},
    "purpose": {"type": "string", "minLength": 20},
    "observed_gap_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "supporting_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "non_goals": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "clean_room_provenance": {"$ref": "#/$defs/provenance"},
    "actors": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/io"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/io"}},
    "state_read_set": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "state_write_set": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "schemas": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "preconditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "postconditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "invariants": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/rule"}},
    "hard_failures": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/rule"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "algorithms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/algorithm"}},
    "deterministic_enforcement": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/rule"}},
    "agent_responsibilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stale_propagation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "failure_modes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/failure"}},
    "recovery_behavior": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "audit_events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
    "security_constraints": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "privacy_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "performance_budget": {"$ref": "#/$defs/budget"},
    "token_budget": {"$ref": "#/$defs/budget"},
    "maintenance_surface": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "interaction_dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "interaction_conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "public_conformance_tests": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/test"}},
    "hidden_property_tests": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/test"}},
    "model_in_loop_tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test"}},
    "acceptance_metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "rejection_conditions": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "rollback": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "migration": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "open_risks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "specification_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "io": {
      "type": "object",
      "required": ["name", "type", "required", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1},
        "authority": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "statement", "enforcement", "severity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "enforcement": {"enum": ["DETERMINISTIC", "AGENT_BOUNDED", "EXTERNAL_FUTURE"]},
        "severity": {"enum": ["BLOCKER", "ERROR", "WARNING", "INFO"]}
      },
      "additionalProperties": false
    },
    "algorithm": {
      "type": "object",
      "required": ["id", "kind", "specification"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["PSEUDOCODE", "STATE_TRANSITION_TABLE", "FORMULA", "INVARIANT", "INPUT_OUTPUT_CONTRACT"]},
        "specification": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["id", "trigger", "consequence", "recovery"],
      "properties": {
        "id": {"type": "string"},
        "trigger": {"type": "string"},
        "consequence": {"type": "string"},
        "recovery": {"type": "string"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["event", "when", "payload_fields"],
      "properties": {
        "event": {"type": "string"},
        "when": {"type": "string"},
        "payload_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["measurement", "limit_or_formula", "hard"],
      "properties": {
        "measurement": {"type": "string"},
        "limit_or_formula": {"type": "string"},
        "hard": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "required": ["test_id", "purpose", "input_class", "expected_relation"],
      "properties": {
        "test_id": {"type": "string"},
        "purpose": {"type": "string"},
        "input_class": {"type": "string"},
        "expected_relation": {"type": "string"}
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["metric_id", "threshold_or_formula", "noncompensatory"],
      "properties": {
        "metric_id": {"type": "string"},
        "threshold_or_formula": {"type": "string"},
        "noncompensatory": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "component_id", "source_inspirations", "source_commits", "source_paths",
        "abstract_mechanisms_observed", "content_not_copied", "project_specific_design",
        "license_status", "allowed_reuse_mode", "contamination_status", "independent_tests",
        "reviewed_by", "provenance_hash"
      ],
      "properties": {
        "component_id": {"type": "string"},
        "source_inspirations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_commits": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "uniqueItems": true},
        "source_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "abstract_mechanisms_observed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "content_not_copied": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "project_specific_design": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "license_status": {"enum": ["VERIFIED_PERMISSIVE_METADATA_ONLY", "UNKNOWN", "UNVERIFIED", "RESTRICTED"]},
        "allowed_reuse_mode": {"const": "REFERENCE_ABSTRACT_MECHANISM"},
        "contamination_status": {"enum": ["CONTAINED_METADATA_ONLY", "UNVERIFIED", "RESTRICTED"]},
        "independent_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "reviewed_by": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "provenance_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
